            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT t.class_name||'#'||t.method_name AS \"Test\",q.reason_rule AS \"Rule\",\n       q.quarantined_at AS \"Quarantined at\",q.consecutive_passes AS \"Consecutive passes\",q.manual AS \"Manual\"\nFROM quarantine q JOIN test_case t ON t.id=q.test_case_id JOIN repository r ON r.id=t.repository_id\nWHERE r.name=${repository:sqlstring} AND q.state='QUARANTINED'\nORDER BY q.quarantined_at,q.id;",
            "refId": "A"
          }
        ],
        "title": "Active quarantine / current state",
