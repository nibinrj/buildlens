            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT count(*) AS \"Quarantined now\"\nFROM quarantine q JOIN test_case t ON t.id=q.test_case_id\nJOIN repository r ON r.id=t.repository_id\nWHERE q.state='QUARANTINED' AND r.name=${repository:sqlstring};",
