        "targets": [
          {
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "buildlens-postgres"
            },
            "editorMode": "code",
            "format": "time_series",
            "rawQuery": true,
            "rawSql": "SELECT date_trunc('day',q.quarantined_at) AS time, count(*)::double precision AS value, 'quarantined'::text AS metric\nFROM quarantine q JOIN test_case t ON t.id=q.test_case_id JOIN repository r ON r.id=t.repository_id\nWHERE r.name=${repository:sqlstring} AND $__timeFilter(q.quarantined_at)\nGROUP BY 1\nUNION ALL\nSELECT date_trunc('day',q.released_at), count(*)::double precision, 'released'::text\nFROM quarantine q JOIN test_case t ON t.id=q.test_case_id JOIN repository r ON r.id=t.repository_id\nWHERE r.name=${repository:sqlstring} AND q.released_at IS NOT NULL AND $__timeFilter(q.released_at)\nGROUP BY 1 ORDER BY 1,3;",
            "refId": "A"
          }
        ],
        "title": "Quarantine activations and releases",
        "type": "timeseries"
      },
