          "showHeader": true
        },
        "targets": [
          {
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "buildlens-postgres"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "WITH detections AS (\n  SELECT q.evidence,q.quarantined_at AS event_time,t.repository_id\n  FROM quarantine q JOIN test_case t ON t.id=q.test_case_id WHERE NOT q.manual\n  UNION ALL\n  SELECT a.payload,a.created_at,a.repository_id FROM alert a\n  WHERE a.type='FLAKY' AND a.payload->>'cap_reached'='true'\n)\nSELECT f->>'rule' AS \"Rule\",count(*) AS \"Evidence occurrences\"\nFROM detections d JOIN repository r ON r.id=d.repository_id\nCROSS JOIN LATERAL jsonb_array_elements(COALESCE(d.evidence->'findings','[]'::jsonb)) f\nWHERE r.name=${repository:sqlstring} AND $__timeFilter(d.event_time)\nGROUP BY 1 ORDER BY 1;",
            "refId": "A"
          }
        ],
        "title": "Detection evidence by rule",
        "type": "table"
      },
