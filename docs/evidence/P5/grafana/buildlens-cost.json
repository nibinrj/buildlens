      {
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "buildlens-postgres"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          },
          "overrides": [
            {
              "matcher": {
