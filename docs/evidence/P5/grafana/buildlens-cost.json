        "id": 5,
        "options": {
          "cellHeight": "sm",
          "footer": {
            "show": false
          },
          "showHeader": true
        },
        "targets": [
          {
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "buildlens-postgres"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT b.branch AS \"Branch\",count(*) AS \"Builds\",count(b.cost_usd) AS \"Known cost builds\",\n       sum(b.cost_usd)::double precision AS \"Equivalent reference USD\"\nFROM build b JOIN repository r ON r.id=b.repository_id\nWHERE r.name=${repository:sqlstring} AND b.agent_lifecycle='LOCAL' AND $__timeFilter(b.started_at)\nGROUP BY b.branch ORDER BY 4 DESC NULLS LAST;",
            "refId": "A"
          }
        ],
        "title": "Equivalent cost by branch",
        "type": "table"
      },
      {
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "buildlens-postgres"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Duration-weighted equivalent USD"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "currencyUSD"
                },
                {
                  "id": "decimals",
                  "value": 6
                }
              ]
            }
          ]
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
