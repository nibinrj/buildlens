            },
            "editorMode": "code",
            "format": "time_series",
            "rawQuery": true,
            "rawSql": "SELECT b.started_at AS time,b.cost_usd::double precision AS value,b.branch AS metric\nFROM build b JOIN repository r ON r.id=b.repository_id\nWHERE r.name=${repository:sqlstring} AND b.agent_lifecycle='LOCAL' AND $__timeFilter(b.started_at)\nORDER BY b.started_at,b.id;",
            "refId": "A"
