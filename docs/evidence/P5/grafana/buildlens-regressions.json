        "targets": [
          {
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "buildlens-postgres"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT b.started_at AS \"Build time\",b.job_name AS \"Job\",b.build_number AS \"Build\",\n       a.payload->>'kind' AS \"Kind\",a.payload->>'name' AS \"Metric\",\n       (a.payload->>'current_ms')::bigint AS \"Latest ms\",\n       (a.payload->>'threshold_ms')::double precision AS \"Threshold ms\",\n       (a.payload->>'samples')::integer AS \"Baseline samples\"\nFROM alert a JOIN build b ON b.id=a.build_id JOIN repository r ON r.id=a.repository_id\nWHERE r.name=${repository:sqlstring} AND a.type='REGRESSION' AND $__timeFilter(b.started_at)\nORDER BY b.started_at DESC,a.id DESC LIMIT 100;",
            "refId": "A"
          }
        ],
        "title": "Latest regression evidence",
        "type": "table"
