        "targets": [
          {
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "buildlens-postgres"
            },
            "editorMode": "code",
            "format": "time_series",
            "rawQuery": true,
            "rawSql": "SELECT b.started_at AS time,\n       (e->>'current_ms')::double precision AS \"Measured ms\",\n       CASE WHEN e->>'status'<>'INSUFFICIENT_DATA' THEN (e->>'median_ms')::double precision END AS \"Baseline median\",\n       CASE WHEN e->>'status'<>'INSUFFICIENT_DATA' THEN (e->>'threshold_ms')::double precision END AS \"Threshold\"\nFROM build b JOIN repository r ON r.id=b.repository_id\nCROSS JOIN LATERAL jsonb_array_elements(COALESCE(b.analysis->'regressions','[]'::jsonb)) e\nWHERE r.name=${repository:sqlstring} AND $__timeFilter(b.started_at)\n  AND e->>'kind'='STAGE' AND e->>'name'=${stage:sqlstring}\nORDER BY b.started_at,b.id;",
            "refId": "A"
          }
        ],
        "title": "Selected stage / measured, median, threshold",
        "type": "timeseries"
      },
