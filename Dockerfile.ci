# Existing Go/lint pins, verified upstream image digest on 2026-10-19.
FROM golangci/golangci-lint:v2.14.0@sha256:ad862ba6b3798cbe0fd9fd7408d498fd74fbd2623a92406b2fd3898faf0bf98f AS lint
FROM golang:1.27.1-trixie@sha256:3b77fc618ec235a1ab412de7737f120dd507c57e8d87de4cbb7994fb94275ed5
COPY --from=lint /usr/bin/golangci-lint /usr/local/bin/golangci-lint
ENV GOTOOLCHAIN=local CGO_ENABLED=1 TESTCONTAINERS_RYUK_DISABLED=true GOMEMLIMIT=1200MiB GOMAXPROCS=2
