<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test-only project for the BuildLens shared library (decision D-017: Maven, run through the Maven wrapper).
  It runs vars/*.groovy outside Jenkins with JenkinsPipelineUnit, which mocks the pipeline steps.
  Nothing here is copied into Jenkins: the library loads only src/, vars/ and resources/ (libraryPath).

  Run:  ./mvnw -B test        (Windows: mvnw.cmd -B test)

  Versions checked 2026-10-04 (docs/study/P2-jenkins-cli-ingest.md):
  - jenkins-pipeline-unit 1.31: https://repo.jenkins-ci.org/releases/ (not on Maven Central since 1.2)
  - groovy-all 2.4.21: the Groovy line Jenkins runs and the version jenkins-pipeline-unit 1.31 depends on
  - JUnit Jupiter 6.1.3, Surefire 3.6.0, GMavenPlus 5.1.0, compiler 3.16.0, resources 3.5.0: Maven Central
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.nibinrj.buildlens</groupId>
  <artifactId>shared-library-tests</artifactId>
  <version>0-SNAPSHOT</version>
  <name>BuildLens shared library tests</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <groovy.version>2.4.21</groovy.version>
    <jenkins-pipeline-unit.version>1.31</jenkins-pipeline-unit.version>
    <junit.version>6.1.3</junit.version>
  </properties>

  <repositories>
    <repository>
      <id>jenkins-ci-releases</id>
      <url>https://repo.jenkins-ci.org/releases/</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>com.lesfurets</groupId>
      <artifactId>jenkins-pipeline-unit</artifactId>
      <version>${jenkins-pipeline-unit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.codehaus.groovy</groupId>
      <artifactId>groovy-all</artifactId>
      <version>${groovy.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testSourceDirectory>test</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.gmavenplus</groupId>
        <artifactId>gmavenplus-plugin</artifactId>
        <version>5.1.0</version>
        <executions>
          <execution>
            <goals>
              <goal>addTestSources</goal>
              <goal>compileTests</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- Groovy 2.4 (the line Jenkins runs) emits Java 8 bytecode at most; JDK 21 runs it. -->
          <targetBytecode>1.8</targetBytecode>
          <testSources>
            <testSource>
              <directory>${project.basedir}/test</directory>
              <includes>
                <include>**/*.groovy</include>
              </includes>
            </testSource>
          </testSources>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
    </plugins>
  </build>
</project>
