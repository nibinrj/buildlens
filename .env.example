# Copy to .env (gitignored) and set real values. Never commit .env.

# Postgres superuser for the local stack. Use URL-safe characters in the password:
# it is placed inside BUILDLENS_DATABASE_URL by docker-compose.yml.
POSTGRES_USER=buildlens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=buildlens

# Grafana admin login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Host ports, bound to 127.0.0.1 only. Chosen to avoid 5432/3000 (other local stacks), 8080 (Jenkins in P2)
# and 8090 (already taken by a Windows service on the dev machine).
BUILDLENS_HOST_PORT=8091
GRAFANA_HOST_PORT=3001
POSTGRES_HOST_PORT=5433

# info | debug | warn | error
BUILDLENS_LOG_LEVEL=info
