    "local-demo"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "query": "SELECT name AS __text,name AS __value FROM repository ORDER BY name",
        "refresh": 1,
        "multi": false,
        "current": {
          "text": "nibinrj/buildlens-lab",
          "value": "nibinrj/buildlens-lab"
        },
        "type": "query",
        "includeAll": false,
        "label": "Repository",
        "options": [],
        "datasource": {
          "uid": "buildlens-postgres",
          "type": "grafana-postgresql-datasource"
        },
        "name": "repository"
      },
      {
        "query": "SELECT DISTINCT s.name AS __text,s.name AS __value FROM stage_run s JOIN build b ON b.id=s.build_id JOIN repository r ON r.id=b.repository_id WHERE r.name=${repository:sqlstring} ORDER BY 1",
        "refresh": 1,
        "multi": false,
        "current": {
          "text": "Test",
          "value": "Test"
        },
        "type": "query",
        "includeAll": false,
        "label": "Stage",
        "options": [],
        "datasource": {
          "uid": "buildlens-postgres",
          "type": "grafana-postgresql-datasource"
        },
        "name": "stage"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "includeVars": true,
